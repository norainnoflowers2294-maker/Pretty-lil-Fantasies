rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can access only their own app backup document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Keep any future per-user subcollections private to that same user.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
